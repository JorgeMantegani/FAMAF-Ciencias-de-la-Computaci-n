# Copiar este archivo a .env y completar los valores.
# El archivo .env NO se sube al repositorio.

# --- Base de datos ---
# SQLite: la base es un archivo local que se crea solo.
DATABASE_URL=sqlite:///./futbot.db

# --- Autenticación ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambiar-por-una-cadena-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_ENABLED=false
REFRESH_EXPIRE_DAYS=7

# --- CORS ---
# Orígenes del frontend autorizados a consumir esta API.
# Protocolo + dominio + puerto, exacto.
CORS_ORIGINS=["http://localhost:5173"]

# --- Simulación de partidos ---
# Ticks por segundo del motor de simulación.
MATCH_TICK_RATE=15
# Duración de un partido amistoso, en segundos.
FRIENDLY_MATCH_DURATION_SECONDS=300
# Tiempo máximo de ejecución del comportamiento de un jugador por tick, en segundos.
BEHAVIOR_TIMEOUT_SECONDS=0.05
