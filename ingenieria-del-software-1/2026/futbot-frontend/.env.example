# Copiar este archivo a .env. El archivo .env NO se sube al repositorio.
# El prefijo VITE_ es obligatorio: sin él, Vite no expone la variable al navegador.

# URL base de la API REST del backend
VITE_API_URL=http://localhost:8000

# URL base de los WebSockets del backend (mismo host y puerto, protocolo ws://)
VITE_WS_URL=ws://localhost:8000
